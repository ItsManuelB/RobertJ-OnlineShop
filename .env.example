# RoberJ Online Shop — environment template
# Copy to .env.local and fill in your values:  cp .env.example .env.local
# Validated at startup by src/config/env.ts (the app fails fast if misconfigured).

# --- Supabase (required) ---
# Find these in your Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (required) ---
# Bot protection on sign-in/sign-up/password-reset. Register a site at
# https://dash.cloudflare.com/?to=/:account/turnstile to get a site key, and
# enable Captcha protection (Turnstile) in Supabase Dashboard → Authentication
# → Attack Protection with the matching secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted server-side jobs only. Never expose to the client. (optional)
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit (Online Payment: GCash, Maya, Card) — sandbox/test-mode keys ---
# Get these from the Xendit Dashboard (Test Mode): Settings → API Keys, and
# Settings → Webhooks → Verification Token. Never commit real values.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Vercel Cron (Phase 4A passive Xendit reconciliation sweep) ---
# Any random secret string. When set, Vercel automatically sends it as
# `Authorization: Bearer <value>` on cron-triggered requests — this route
# rejects any request without a matching header. Generate with:
# openssl rand -base64 32
CRON_SECRET=

# --- Return/refund emails (optional) ---
# Resend API key and the From address. Leave both empty to keep emails off; the
# app works the same without them. The From domain must be verified in Resend.
# Example: EMAIL_FROM="RobertJ Shop <no-reply@your-verified-domain>"
RESEND_API_KEY=
EMAIL_FROM=
# Optional. A monitored address (e.g. support@your-verified-domain) so a reply to an
# email reaches a person instead of the no-reply From address.
EMAIL_REPLY_TO=
